# NTMS medical-system → Gateway :8091
# Insert inside the listen 443 ssl server { ... } block (before location /).

    # SPA + static (baseHref /transfer/)
    location ^~ /transfer/ {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_hide_header  X-Powered-By;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Medical API only（避免整站 /api 搶走既有系統）
    # 含 /api/transfer、/api/transfers
    location ^~ /api/transfer {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_hide_header  X-Powered-By;
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_read_timeout 300s;
    }

    location ^~ /api/mongo {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_hide_header  X-Powered-By;
        proxy_http_version 1.1;
    }

    location ^~ /api/speech-to-text {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_hide_header  X-Powered-By;
        proxy_http_version 1.1;
        client_max_body_size 50M;
        proxy_read_timeout 300s;
    }

    location ^~ /api/stt/ {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_hide_header  X-Powered-By;
        proxy_http_version 1.1;
    }

    location = /api/ping {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_hide_header  X-Powered-By;
        proxy_http_version 1.1;
    }
